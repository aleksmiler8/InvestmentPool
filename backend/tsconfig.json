{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
"moduleResolution": "node",

"ignoreDeprecations": "6.0",

    "strict": true,

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "skipLibCheck": true,
    "rootDir": "src",

    "outDir": "dist",

    "types": ["node"]
  },

  "include": [
    "src/**/*"
  ]
}